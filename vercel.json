{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "functions": {
    "api/agent-911.js": {
      "maxDuration": 60
    },
    "api/astro-911.js": {
      "maxDuration": 60
    },
    "api/checkout.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/astronomy-engine/esm/package.json"
    },
    "api/payment.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/astronomy-engine/esm/package.json"
    },
    "api/payment-status.js": {
      "maxDuration": 30
    },
    "api/mercadopago-webhook.js": {
      "maxDuration": 30
    },
    "api/order-status.js": {
      "maxDuration": 30
    },
    "api/astral-order.js": {
      "maxDuration": 20
    },
    "api/astral-admin-delivery.js": {
      "maxDuration": 20
    },
    "api/astral-admin.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/astronomy-engine/esm/package.json"
    },
    "api/astro-question.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
