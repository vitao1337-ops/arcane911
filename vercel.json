{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "functions": {
    "api/agent-911.js": {
      "maxDuration": 60
    },
    "api/astro-911.js": {
      "maxDuration": 60
    },
    "api/checkout.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/astronomy-engine/esm/package.json"
    },
    "api/payment.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/astronomy-engine/esm/package.json"
    },
    "api/payment-status.js": {
      "maxDuration": 30
    },
    "api/mercadopago-webhook.js": {
      "maxDuration": 30
    },
    "api/order-status.js": {
      "maxDuration": 30
    },
    "api/astral-order.js": {
      "maxDuration": 20
    },
    "api/astral-admin-delivery.js": {
      "maxDuration": 20
    },
    "api/astral-admin.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/astronomy-engine/esm/package.json"
    },
    "api/astro-question.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/cards/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=31536000, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/geo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
