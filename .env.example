VITE_CHECKOUT_URL=
VITE_PRODUCT_ID=arcane911-leitura-profunda
VITE_OFFER_PRICE=

# Agente 911 conectado. Segredos existem somente no servidor.
GEMINI_API_KEY=cole-sua-chave-aqui
AGENT911_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# OpenAI continua opcional. Só é chamada com AGENT911_PROVIDER=openai
# ou em auto quando não existir uma chave Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

ARCANE911_ALLOWED_ORIGINS=
VITE_AGENT911_ENABLED=true
# live = Gemini server-side, sem texto local provisório; local = motor local escolhido deliberadamente.
VITE_AGENT911_MODE=live
VITE_AGENT911_ENDPOINT=/api/agent-911

# npm run dev usa a função publicada e nunca expõe GEMINI_API_KEY ao Vite.
ARCANE911_DEV_API_TARGET=https://arcane911.vercel.app

VITE_AGENT911_PRODUCT_ID=agent911-tres-perguntas
VITE_AGENT911_QUESTION_LIMIT=3
VITE_AGENT911_DRAFT_PRICE=
VITE_AGENT911_CHECKOUT_URL=
