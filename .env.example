# Checkout hospedado do Stripe. Esta chave existe somente no servidor/Vercel.
# Use sk_test_... em Preview e sk_live_... somente em Production.
STRIPE_SECRET_KEY=

# Obrigatório antes de abrir qualquer cobrança. Copie o whsec_... do endpoint
# /api/stripe-webhook criado no Stripe Workbench/Webhooks.
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Ative somente depois de cadastrar a URL pública dos Termos no Stripe.
STRIPE_REQUIRE_TERMS_ACCEPTANCE=false

# Livro-caixa server-side de todos os produtos pagos.
# Execute database/arcane911-payment-ledger.sql antes de habilitar cobrança.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Compatibilidade temporária com projetos antigos; prefira SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Catálogo comercial. A função server-side recalcula o valor por este catálogo
# e nunca aceita preço enviado pelo navegador.
VITE_COMPLETE_READING_PRODUCT_ID=arcane911-leitura-profunda
VITE_COMPLETE_READING_PRICE_CENTS=1999
VITE_AGENT911_QUESTION_PRODUCT_ID=agent911-pergunta
VITE_AGENT911_QUESTION_PRICE_CENTS=500
VITE_AGENT911_QUESTION_LIMIT=3

# Perguntas específicas de cinco cartas: R$ 5 depois da Tiragem Completa e
# R$ 10 quando compradas de forma avulsa.
VITE_SPECIFIC_QUESTION_COMPLETE_PRODUCT_ID=arcane911-pergunta-especifica-completa
VITE_SPECIFIC_QUESTION_COMPLETE_PRICE_CENTS=500
VITE_SPECIFIC_QUESTION_STANDALONE_PRODUCT_ID=arcane911-pergunta-especifica-avulsa
VITE_SPECIFIC_QUESTION_STANDALONE_PRICE_CENTS=1000

# Documento Astral: vazio mantém o documento aberto em validação. Ao definir
# um valor positivo, a UI ativa o bloqueio e o servidor usa o mesmo catálogo.
VITE_ASTRO911_PRODUCT_ID=astro911-documento-completo
VITE_ASTRO911_PRICE_CENTS=

# Agent 911 em produção. Todas as chaves existem somente no servidor.
GEMINI_API_KEY=
AGENT911_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Paraquedas opcional: só entra após falha recuperável dos dois modelos Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Teto conservador do Agent 911 por consulta. Ajuste os preços somente quando
# a tabela dos provedores mudar; o tráfego pago continua pausado até a margem
# real ficar positiva no cenário conservador.
AGENT911_MAX_COST_BRL=1.00
AGENT911_USD_BRL_BUDGET_RATE=6.00
AGENT911_MAX_OUTPUT_TOKENS=4096
AGENT911_GEMINI_INPUT_USD_PER_M=1.50
AGENT911_GEMINI_OUTPUT_USD_PER_M=9.00
AGENT911_OPENAI_INPUT_USD_PER_M=2.00
AGENT911_OPENAI_OUTPUT_USD_PER_M=12.00

# Proteções server-side. Vazias usam os padrões documentados.
ARCANE911_RATE_LIMIT=
ARCANE911_RATE_WINDOW_MS=
AGENT911_PROVIDER_TIMEOUT_MS=
AGENT911_TOTAL_TIMEOUT_MS=
AGENT911_QUOTA_COOLDOWN_MS=
AGENT911_PROVIDER_COOLDOWN_MS=
AGENT911_DEDUPE_TTL_MS=
ARCANE911_ALLOWED_ORIGINS=

# Identificação pública obrigatória antes da venda em produção.
VITE_LEGAL_OPERATOR_NAME=
VITE_SUPPORT_EMAIL=
VITE_PUBLIC_SITE_URL=

VITE_AGENT911_ENABLED=true
VITE_AGENT911_ENDPOINT=/api/agent-911

# Documento Astral. Gemini permanece principal; OpenAI é paraquedas opcional.
VITE_ASTRO911_ENABLED=true
VITE_ASTRO911_ENDPOINT=/api/astro-911
ASTRO911_PROVIDER=gemini
# Opcionais: se vazias, herdam os modelos gerais acima.
ASTRO911_MODEL=
ASTRO911_FALLBACK_MODEL=
ASTRO911_OPENAI_MODEL=
ASTRO911_RATE_LIMIT=
ASTRO911_RATE_WINDOW_MS=
ASTRO911_PROVIDER_TIMEOUT_MS=
ASTRO911_TOTAL_TIMEOUT_MS=
ASTRO911_QUOTA_COOLDOWN_MS=
ASTRO911_PROVIDER_COOLDOWN_MS=
ASTRO911_DEDUPE_TTL_MS=
ASTRO911_MAX_OUTPUT_TOKENS=

# DEV é mock e gratuito por padrão. Para testar a rota real, preencha os dois
# campos explicitamente e reinicie npm run dev. Nunca há fallback silencioso para produção.
ARCANE911_DEV_REAL_AI=false
ARCANE911_DEV_API_TARGET=
# Libera produtos pagos somente no Vite DEV. Em build/Preview/produção é ignorado.
ARCANE911_DEV_UNLOCK_PAID=true
