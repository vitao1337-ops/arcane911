VITE_CHECKOUT_URL=
VITE_PRODUCT_ID=arcane911-leitura-profunda
VITE_OFFER_PRICE=

# Agent 911 em produção. Todas as chaves existem somente no servidor.
GEMINI_API_KEY=
AGENT911_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Paraquedas opcional: só entra após falha recuperável dos dois modelos Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Proteções server-side. Vazias usam os padrões documentados.
ARCANE911_RATE_LIMIT=
ARCANE911_RATE_WINDOW_MS=
AGENT911_PROVIDER_TIMEOUT_MS=
AGENT911_TOTAL_TIMEOUT_MS=
AGENT911_QUOTA_COOLDOWN_MS=
AGENT911_PROVIDER_COOLDOWN_MS=
AGENT911_DEDUPE_TTL_MS=
ARCANE911_ALLOWED_ORIGINS=

VITE_AGENT911_ENABLED=true
VITE_AGENT911_ENDPOINT=/api/agent-911

# Documento Astral Gemini. Reutiliza GEMINI_API_KEY somente no servidor.
VITE_ASTRO911_ENABLED=true
VITE_ASTRO911_ENDPOINT=/api/astro-911
# Opcionais: se vazias, herdam GEMINI_MODEL e GEMINI_FALLBACK_MODEL.
ASTRO911_MODEL=
ASTRO911_FALLBACK_MODEL=

# DEV é mock e gratuito por padrão. Para testar a rota real, preencha os dois
# campos explicitamente e reinicie npm run dev. Nunca há fallback silencioso para produção.
ARCANE911_DEV_REAL_AI=false
ARCANE911_DEV_API_TARGET=

VITE_AGENT911_PRODUCT_ID=agent911-tres-perguntas
VITE_AGENT911_QUESTION_LIMIT=3
VITE_AGENT911_DRAFT_PRICE=
VITE_AGENT911_CHECKOUT_URL=
