# Mercado Pago · único provedor de pagamento do Arcane911 V30.
# Chave privada: servidor/Vercel somente. Nunca use prefixo VITE_.
MERCADOPAGO_ACCESS_TOKEN=
# Gate server-side: use production somente junto das credenciais produtivas.
MERCADOPAGO_MODE=test
# Chave pública usada pelo Payment Brick oficial no navegador.
VITE_MERCADOPAGO_PUBLIC_KEY=
# Chave secreta gerada em Suas integrações > Webhooks.
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional. Se vazio, usa VITE_PUBLIC_SITE_URL + /api/mercadopago-webhook.
MERCADOPAGO_NOTIFICATION_URL=

# Ledger server-side de todos os produtos pagos.
# Em instalação nova, execute database/arcane911-payment-ledger.sql.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Catálogo comercial. O servidor recalcula estes valores e ignora preço do navegador.
VITE_COMPLETE_READING_PRODUCT_ID=arcane911-leitura-profunda
VITE_COMPLETE_READING_PRICE_CENTS=1999
VITE_COMPLETE_INCLUDED_QUESTIONS=5
VITE_AGENT911_QUESTION_PRODUCT_ID=agent911-pergunta
VITE_AGENT911_QUESTION_PRICE_CENTS=500
VITE_AGENT911_QUESTION_LIMIT=3
VITE_SPECIFIC_QUESTION_COMPLETE_PRODUCT_ID=arcane911-pergunta-especifica-completa
VITE_SPECIFIC_QUESTION_COMPLETE_PRICE_CENTS=500
VITE_SPECIFIC_QUESTION_STANDALONE_PRODUCT_ID=arcane911-pergunta-especifica-avulsa
VITE_SPECIFIC_QUESTION_STANDALONE_PRICE_CENTS=1000
VITE_ASTRO911_PRODUCT_ID=astro911-documento-completo
VITE_ASTRO911_PRICE_CENTS=11990
VITE_ASTRO911_ALLOW_FREE_PRODUCTION=false

# Agent 911 em produção. Todas as chaves privadas existem somente no servidor.
GEMINI_API_KEY=
AGENT911_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
AGENT911_MAX_COST_BRL=1.00
AGENT911_USD_BRL_BUDGET_RATE=6.00
AGENT911_MAX_OUTPUT_TOKENS=4096
AGENT911_GEMINI_INPUT_USD_PER_M=1.50
AGENT911_GEMINI_OUTPUT_USD_PER_M=9.00
AGENT911_OPENAI_INPUT_USD_PER_M=2.00
AGENT911_OPENAI_OUTPUT_USD_PER_M=12.00

# Proteções server-side.
ARCANE911_RATE_LIMIT=
ARCANE911_RATE_WINDOW_MS=
AGENT911_PROVIDER_TIMEOUT_MS=
AGENT911_TOTAL_TIMEOUT_MS=
AGENT911_QUOTA_COOLDOWN_MS=
AGENT911_PROVIDER_COOLDOWN_MS=
AGENT911_DEDUPE_TTL_MS=
ARCANE911_ALLOWED_ORIGINS=

# Identificação pública obrigatória antes da venda.
VITE_LEGAL_OPERATOR_NAME=
VITE_SUPPORT_EMAIL=
VITE_PUBLIC_SITE_URL=https://arcane911.vercel.app

VITE_AGENT911_ENABLED=true
VITE_AGENT911_ENDPOINT=/api/agent-911
VITE_ASTRO911_ENABLED=true
VITE_ASTRO911_ENDPOINT=/api/astro-911
ASTRO911_PROVIDER=gemini
ASTRO911_MODEL=
ASTRO911_FALLBACK_MODEL=
ASTRO911_OPENAI_MODEL=
ASTRO911_RATE_LIMIT=
ASTRO911_RATE_WINDOW_MS=
ASTRO911_PROVIDER_TIMEOUT_MS=
ASTRO911_TOTAL_TIMEOUT_MS=
ASTRO911_QUOTA_COOLDOWN_MS=
ASTRO911_PROVIDER_COOLDOWN_MS=
ASTRO911_DEDUPE_TTL_MS=
ASTRO911_MAX_OUTPUT_TOKENS=
ASTRO911_MAX_COST_BRL=2.00
ASTRO911_USD_BRL_BUDGET_RATE=6.00
ASTRO911_GEMINI_INPUT_USD_PER_M=1.50
ASTRO911_GEMINI_OUTPUT_USD_PER_M=9.00
ASTRO911_OPENAI_INPUT_USD_PER_M=2.00
ASTRO911_OPENAI_OUTPUT_USD_PER_M=12.00

# DEV continua mock e gratuito por padrão.
ARCANE911_DEV_REAL_AI=false
ARCANE911_DEV_API_TARGET=
ARCANE911_DEV_UNLOCK_PAID=true

# Segredo privado para marcar a síntese humana como entregue (servidor somente)
ASTRO911_ADMIN_SECRET=

# Perguntas astrais: fallback OpenAI somente com opt-in e saldo verificado.
ASTRO911_ALLOW_OPENAI_FALLBACK=false
